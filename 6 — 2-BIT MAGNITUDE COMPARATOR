module comparator2bit(a, b, eq, gt, lt);
    input [1:0] a, b;
    output reg eq, gt, lt;
    always @(a or b) begin
        if (a == b) begin eq=1; gt=0; lt=0; end
        else if (a > b) begin eq=0; gt=1; lt=0; end
        else begin eq=0; gt=0; lt=1; end
    end
endmodule

