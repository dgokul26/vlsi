module demux1to4(d, s, y);
    input d;
    input [1:0] s;
    output reg [3:0] y;
    always @(s or d) begin
        y = 4'b0000;
        case (s)
            2'b00: y[0] = d;
            2'b01: y[1] = d;
            2'b10: y[2] = d;
            2'b11: y[3] = d;
        endcase
    end
endmodule

TB:
module tb_demux1to4;
    reg d;
    reg [1:0] s;
    wire [3:0] y;
    demux1to4 uut(d, s, y);
    initial begin
        d = 1;
        #10 s = 2'b00;
        #10 s = 2'b01;
        #10 s = 2'b10;
        #10 s = 2'b11;
        #10 $finish;
    end
    initial $monitor("d=%b s=%b | y=%b", d, s, y);
endmodule
