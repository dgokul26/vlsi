module tb_traffic_light;
    reg clk, rst;
    wire red, yellow, green;
    traffic_light uut(clk, rst, red, yellow, green);
    always #5 clk = ~clk;
    initial begin
        clk=0; rst=0;
        #10 rst=1;
        #400 $finish;
    end
    initial $monitor("t=%0t | red=%b yellow=%b green=%b", $time, red, yellow, green);
endmodule
