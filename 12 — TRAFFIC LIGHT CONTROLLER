module traffic_light(clk, rst, red, yellow, green);
    input clk, rst;
    output reg red, yellow, green;
    reg [1:0] state;
    reg [3:0] count;
    parameter RED=0, GREEN=1, YELLOW=2;

    always @(posedge clk or negedge rst) begin
        if (!rst) begin
            state <= RED;
            count <= 0;
        end else begin
            count <= count + 1;
            case (state)
                RED:    if (count == 9)  begin state <= GREEN;  count <= 0; end
                GREEN:  if (count == 9)  begin state <= YELLOW; count <= 0; end
                YELLOW: if (count == 3)  begin state <= RED;    count <= 0; end
            endcase
        end
    end

    always @(*) begin
        red    = (state == RED);
        green  = (state == GREEN);
        yellow = (state == YELLOW);
    end
endmodule

