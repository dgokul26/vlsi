module tb_sync_counter;
    reg clk, rst, up_down;
    wire [3:0] out;
    sync_counter uut(clk, rst, up_down, out);
    always #5 clk = ~clk;
    initial begin
        clk=0; rst=0; up_down=0;
        #10 rst=1;
        #80 up_down=1;
        #80 $finish;
    end
    initial $monitor("t=%0t | out=%b", $time, out);
endmodule
