module sync_counter(clk, rst, up_down, out);
    input clk, rst, up_down;
    output reg [3:0] out;
    always @(posedge clk or negedge rst) begin
        if (!rst)
            out <= 4'b0000;
        else if (up_down)
            out <= out - 1'b1;   // down count
        else
            out <= out + 1'b1;   // up count
    end
endmodule

