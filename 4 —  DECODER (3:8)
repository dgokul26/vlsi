module decoder3to8(a, b, c, y);
    input a, b, c;
    output [7:0] y;
    assign y[0] = ~a & ~b & ~c;
    assign y[1] = ~a & ~b &  c;
    assign y[2] = ~a &  b & ~c;
    assign y[3] = ~a &  b &  c;
    assign y[4] =  a & ~b & ~c;
    assign y[5] =  a & ~b &  c;
    assign y[6] =  a &  b & ~c;
    assign y[7] =  a &  b &  c;
endmodule

TB:
module tb_decoder3to8;
    reg a, b, c;
    wire [7:0] y;
    decoder3to8 uut(a, b, c, y);
    integer i;
    initial begin
        {a,b,c} = 3'b000;
        for (i=0; i<8; i=i+1) begin
            #10 {a,b,c} = i;
        end
        #10 $finish;
    end
    initial $monitor("a=%b b=%b c=%b | y=%b", a, b, c, y);
endmodule
