module tb_alu16;
    reg clk, rst;
    reg [15:0] a, b;
    reg [2:0] opcode;
    wire [15:0] z;
    alu16 uut(clk, rst, a, b, opcode, z);

    always #5 clk = ~clk;

    initial begin
        clk = 0; rst = 0; a = 16'd20; b = 16'd5; opcode = 0;
        #10 rst = 1;
        opcode = 0; #10;
        opcode = 1; #10;
        opcode = 2; #10;
        opcode = 3; #10;
        opcode = 4; #10;
        opcode = 5; #10;
        opcode = 6; #10;
        opcode = 7; #10;
        $finish;
    end
    initial $monitor("op=%d a=%d b=%d | z=%d", opcode, a, b, z);
endmodule
