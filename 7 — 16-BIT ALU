module alu16(clk, rst, a, b, opcode, z);
    input clk, rst;
    input [15:0] a, b;
    input [2:0] opcode;
    output reg [15:0] z;
    always @(posedge clk or negedge rst) begin
        if (!rst)
            z <= 16'b0;
        else begin
            case (opcode)
                3'd0: z <= a + b;
                3'd1: z <= a - b;
                3'd2: z <= a * b;
                3'd3: z <= a / b;
                3'd4: z <= a & b;
                3'd5: z <= a | b;
                3'd6: z <= a ^ b;
                3'd7: z <= ~a;
            endcase
        end
    end
endmodule

