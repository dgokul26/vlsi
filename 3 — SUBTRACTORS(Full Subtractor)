module full_subtractor(a, b, bin, diff, bout);
    input a, b, bin;
    output reg diff, bout;
    always @(a or b or bin) begin
        diff = a ^ b ^ bin;
        bout = ((~a) & b) | (b & bin) | (bin & (~a));
    end
endmodule

