module tb_digital_clock;
    reg clk, rst;
    wire [5:0] sec, min;
    wire [4:0] hour;
    digital_clock uut(clk, rst, sec, min, hour);
    always #5 clk = ~clk;   // each pulse = 1 "second" tick for simulation
    initial begin
        clk=0; rst=0;
        #10 rst=1;
        #700 $finish;       // enough ticks to see minute rollover
    end
    initial $monitor("t=%0t | H:%d M:%d S:%d", $time, hour, min, sec);
endmodule
