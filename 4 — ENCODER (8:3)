module encoder8to3(y, a, b, c);
    input [7:0] y;
    output a, b, c;
    or(a, y[4], y[5], y[6], y[7]);
    or(b, y[2], y[3], y[6], y[7]);
    or(c, y[1], y[3], y[5], y[7]);
endmodule

