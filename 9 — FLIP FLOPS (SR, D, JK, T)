T Flip Flop:
module t_ff(t, rst, clk, q);
    input t, rst, clk;
    output reg q;
    always @(posedge clk or negedge rst) begin
        if (rst == 0)
            q <= 1'b0;
        else
            q <= q ^ t;
    end
endmodule

