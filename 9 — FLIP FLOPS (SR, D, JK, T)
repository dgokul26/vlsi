SR Flip Flop:
module sr_ff(s, r, clk, rst, q);
    input s, r, clk, rst;
    output reg q;
    always @(posedge clk or negedge rst) begin
        if (!rst)
            q <= 0;
        else begin
            case ({s,r})
                2'b00: q <= q;
                2'b01: q <= 0;
                2'b10: q <= 1;
                2'b11: q <= 1'bx; // invalid state
            endcase
        end
    end
endmodule

TB:
module tb_sr_ff;
    reg s, r, clk, rst;
    wire q;
    sr_ff uut(s, r, clk, rst, q);
    always #5 clk = ~clk;
    initial begin
        clk=0; rst=0; s=0; r=0;
        #10 rst=1;
        #10 s=1; r=0;
        #10 s=0; r=0;
        #10 s=0; r=1;
        #10 s=0; r=0;
        #10 $finish;
    end
    initial $monitor("s=%b r=%b | q=%b", s, r, q);
endmodule


D Flip Flop:
module d_ff(d, rst, clk, q);
    input d, rst, clk;
    output reg q;
    always @(posedge clk or negedge rst) begin
        if (rst == 0)
            q <= 1'b0;
        else
            q <= d;
    end
endmodule

