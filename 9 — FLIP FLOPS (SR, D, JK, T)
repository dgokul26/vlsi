    always #5 clk = ~clk;
    initial begin
        clk=0; rst=0; d=0;
        #10 rst=1;
        #10 d=1;
        #10 d=0;
        #10 d=1;
        #10 $finish;
    end
    initial $monitor("d=%b | q=%b", d, q);
endmodule


JK Flip Flop:
module jk_ff(j, k, clk, rst, q);
    input j, k, clk, rst;
    output reg q;
    always @(posedge clk or negedge rst) begin
        if (!rst)
            q <= 0;
        else begin
            case ({j,k})
                2'b00: q <= q;
                2'b01: q <= 0;
                2'b10: q <= 1;
                2'b11: q <= ~q;
            endcase
        end
    end
endmodule

